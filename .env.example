# ==========================================
# RevClaim AI — Environment Configuration
# ==========================================

# 1. ElevenLabs Conversational AI & Outbound Telephony
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_AGENT_ID=your_elevenlabs_conversational_agent_id
ELEVENLABS_PHONE_NUMBER_ID=your_elevenlabs_registered_phone_id
ELEVENLABS_WEBHOOK_SECRET=your_elevenlabs_webhook_secret

# 2. Twilio Telephony (Live Outbound Dialing)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# 3. Dodo Payments (Merchant of Record & Instant Checkout)
DODO_PAYMENTS_API_KEY=your_dodo_payments_api_key
DODO_PAYMENTS_WEBHOOK_KEY=your_dodo_webhook_secret_key
DODO_PAYMENTS_RETURN_URL=http://localhost:3000/settlement/success
DODO_PAYMENTS_ENVIRONMENT=test_mode

# 4. Supabase Database (PostgreSQL + RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# 5. Dual LLM Engines (Gemini Primary + Groq Fallback)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# 6. Real-Time Speech Recognition & Memory (Deepgram + Mem0)
DEEPGRAM_API_KEY=your_deepgram_api_key_here
MEM0_API_KEY=your_mem0_api_key_here

# 7. Indic & WebRTC Voice Engines (Gnani.ai Vachana + LiveKit WebRTC)
GNANI_API_KEY=your_gnani_vachana_api_key_here
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_URL=wss://your-project.livekit.cloud
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# 8. viaSocket MCP (Workflow Automation & WhatsApp Dispatch)
VIASOCKET_API_KEY=HHGOA26-VIASOCKET
VIASOCKET_MCP_ENDPOINT=https://flow.viasocket.com/service/mcp/trigger

# 9. Resend Autonomous Email Stack
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=RevClaim AI <onboarding@resend.dev>

# 10. App Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NODE_ENV=development
